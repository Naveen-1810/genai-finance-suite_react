# Copy this file to ".env" and fill in your OWN values.
# NEVER commit the real ".env" file to Git.

# Database: Leave blank to use local SQLite (finance_pro.db).
# For cloud hosting (Supabase/PostgreSQL), paste your PostgreSQL connection string:
DATABASE_URL=

# Secret key for signing JWT tokens (use a long random string in production)
JWT_SECRET=genai-finance-suite-jwt-secret-key-2026

# Gemini API Key: Get a fresh key from https://aistudio.google.com/
GEMINI_API_KEY=

# Path to your Google service account JSON (for Google Sheets sync). Optional.
GOOGLE_CREDENTIALS_PATH=

# Comma separated list of allowed frontend origins for CORS
FRONTEND_ORIGIN=http://localhost:5173
