# Copy this file to ".env" and fill in your OWN values.
# NEVER commit the real ".env" file to Git.

# Get a fresh key from https://aistudio.google.com/ (rotate the old leaked one first!)
GEMINI_API_KEY=

# Path to your Google service account JSON (for Google Sheets sync). Optional.
# Put the actual file OUTSIDE version control, e.g. backend/secrets/credentials.json
GOOGLE_CREDENTIALS_PATH=

# Default Google Sheet URL used by the sync button (optional, can be left blank)
DEFAULT_GSHEET_URL=

# Comma separated list of allowed frontend origins for CORS
FRONTEND_ORIGIN=http://localhost:5173
